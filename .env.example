# Vrummm Customer Mobile App Environment Variables

# 1. API Base URL (Node + Express backend)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000

# 2. Maps & Location Search API Keys (Choose one or more)
# If using Google Maps (Places API, Geocoding, Directions):
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# If using LocationIQ (Free 5,000 req/day):
EXPO_PUBLIC_LOCATIONIQ_API_KEY=

# If using Geoapify (Free 3,000 req/day):
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# 3. Razorpay Test Mode Key (for mock/test payments)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
